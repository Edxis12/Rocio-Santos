{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
    height: 100%;
  }

  .product-grid__card swatches-variant-picker-component overflow-list::part(list) {
    flex-wrap: wrap;
  }

  @media screen and (max-width: 749px) {
    .product-grid__card .group-block > :is(.mobile-column, :not(.layout-panel-flex--row)) {
      flex-direction: column;
    }
  }

  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* --- Rocio Santos: título de producto --- */
  .product-grid__card a[ref='productTitleLink'] p[role='heading'] {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    font-style: italic;
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0;
    text-transform: none;
    margin-top: 0.35rem;
  }

  @media screen and (max-width: 749px) {
    .product-grid__card a[ref='productTitleLink'] p[role='heading'] {
      -webkit-line-clamp: 3;
    }
  }

  /* --- Rocio Santos: precio siempre anclado abajo --- */
  .product-grid__card product-price {
    margin-top: auto;
    padding-top: 0.35rem;
  }

  /* --- Rocio Santos: color y tamaño del precio --- */
  .product-grid__card product-price .price {
    color: rgb(var(--color-foreground-rgb) / 0.65);
    font-style: normal;
    font-size: 0.9rem;
    font-weight: 400;
  }

  /* --- Rocio Santos: imagen con hover sutil --- */
  .product-grid__card img {
    transition: opacity 0.35s ease;
  }

  .product-card:hover .product-grid__card img {
    opacity: 0.88;
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
